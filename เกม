<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Blox Fruits 2D - Mobile</title>
<style>
:root { --safe-bottom: env(safe-area-inset-bottom, 0px); }
* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; background: #15191e; color: #fff; font-family: system-ui, sans-serif; overflow: hidden; touch-action: none; user-select: none; }
body { display: flex; flex-direction: column; align-items: center; padding: 8px 8px calc(8px + var(--safe-bottom)); }
h1 { margin: 2px 0 6px; color: #f1c40f; font-size: clamp(18px, 5vw, 25px); text-align: center; text-shadow: 2px 2px #8e2c20; }
#gameCanvas { display: block; width: min(100%, 800px); height: auto; aspect-ratio: 4 / 3; background: #27ae60; border: 3px solid #34495e; border-radius: 10px; box-shadow: 0 0 14px #000; touch-action: none; }
.instructions { width: min(100%, 800px); margin: 5px 0 0; color: #bdc3c7; font-size: 12px; text-align: center; }
.controls { width: min(100%, 800px); display: flex; justify-content: space-between; align-items: flex-end; padding: 10px 2px 0; gap: 8px; }
.dpad { display: grid; grid-template: repeat(3, 42px) / repeat(3, 42px); gap: 4px; }
button { -webkit-tap-highlight-color: transparent; touch-action: none; }
.move, .skill, .attack { color: white; font-weight: 700; border: 2px solid rgba(255,255,255,.5); cursor: pointer; }
.move { width: 42px; height: 42px; border-radius: 9px; background: rgba(255,255,255,.16); font-size: 18px; }
.move:active, .skill:active, .attack:active { filter: brightness(1.35); transform: scale(.96); }
.up { grid-area: 1 / 2; } .left { grid-area: 2 / 1; } .right { grid-area: 2 / 3; } .down { grid-area: 3 / 2; }
.actions { display: flex; align-items: flex-end; gap: 6px; }
.skill { position: relative; overflow: hidden; width: 54px; height: 54px; border-radius: 50%; background: #2980b9; font-size: 16px; }
.skill small { display: block; font-size: 9px; }
.cooldown { position: absolute; z-index: 0; inset: auto 0 0; height: 0; background: rgba(0,0,0,.65); pointer-events: none; }
.skill span { position: relative; z-index: 1; }
.attack { width: 70px; height: 70px; border-radius: 50%; background: #c0392b; font-size: 14px; }
@media (max-height: 600px) and (orientation: landscape) { body { padding-top: 2px; } h1, .instructions { display: none; } #gameCanvas { width: min(72vw, 800px); } .controls { position: fixed; bottom: 4px; left: 2vw; right: 2vw; width: 96vw; } }
</style>
</head>
<body>
<h1>Blox Fruits 2D 🎯</h1>
<canvas id="gameCanvas" width="800" height="600"></canvas>
<div class="instructions">แตะบนสนามเพื่อเล็งและโจมตี • มือถือใช้ปุ่มด้านล่าง • คอมพิวเตอร์ใช้ WASD, Space, Z, X</div>
<div class="controls">
  <div class="dpad">
    <button class="move up" data-key="w">▲</button><button class="move left" data-key="a">◀</button>
    <button class="move right" data-key="d">▶</button><button class="move down" data-key="s">▼</button>
  </div>
  <div class="actions">
    <button class="skill" id="btnZ"><i class="cooldown" id="cdZ"></i><span>Z<small>Skill 1</small></span></button>
    <button class="skill" id="btnX"><i class="cooldown" id="cdX"></i><span>X<small>Skill 2</small></span></button>
    <button class="attack" id="btnAttack">⚔️ ตี</button>
  </div>
</div>
<script>
const canvas = document.getElementById('gameCanvas'), ctx = canvas.getContext('2d');
ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
const fruits = [
  {name:'Chop', emoji:'🍈', player:'🥷', stars:1, weight:35, buff:'dmg'},
  {name:'Smoke', emoji:'🍇', player:'🌫️', stars:2, weight:25, buff:'range'},
  {name:'Rubber', emoji:'🟣', player:'🦸‍♂️', stars:2, weight:20, buff:'rubber'},
  {name:'Flame', emoji:'🍒', player:'🔥', stars:3, weight:15, buff:'fire'},
  {name:'Ice', emoji:'🧊', player:'⛄', stars:3, weight:15, buff:'ice'},
  {name:'Light', emoji:'🍍', player:'⚡', stars:4, weight:8, buff:'speed'},
  {name:'Quake', emoji:'🌍', player:'🧔‍♂️', stars:5, weight:3, buff:'quake'},
  {name:'Buddha', emoji:'🍌', player:'🧘‍♂️', stars:5, weight:2, buff:'giant'},
  {name:'Dragon', emoji:'🐉', player:'🐲', stars:6, weight:1, buff:'dragon'}
];
const player = {x:400,y:300,size:40,speed:5,damage:35,range:60,hp:100,maxHp:100,xp:0,maxXp:100,level:1,beli:0,fruit:null,aim:{x:1,y:0},attackCd:0,z:0,zMax:120,x:0,xMax:250};
let fruit = {x:200,y:200,size:35,data:fruits[0]}, enemies=[], shots=[], effects=[], boss=null, wave=1, kills=0, over=false;
const keys = Object.create(null), bosses=['🦍','🦈','🦖','👽','👹'];
function spawnFruit(){ fruit.x=30+Math.random()*740; fruit.y=50+Math.random()*500; let n=Math.random()*fruits.reduce((a,f)=>a+f.weight,0); fruit.data=fruits.find(f=>(n-=f.weight)<0)||fruits[0]; }
function aim(e, attack=false){ const r=canvas.getBoundingClientRect(), x=(e.clientX-r.left)*800/r.width, y=(e.clientY-r.top)*600/r.height; const dx=x-player.x,dy=y-player.y,d=Math.hypot(dx,dy); if(d){player.aim.x=dx/d;player.aim.y=dy/d;} if(attack) hit(); }
canvas.addEventListener('pointerdown',e=>{e.preventDefault();aim(e,true);});
canvas.addEventListener('pointermove',e=>{if(e.buttons) aim(e);});
addEventListener('keydown',e=>{keys[e.key.toLowerCase()]=true;if(e.code==='Space')hit();if(e.code==='KeyZ')skillZ();if(e.code==='KeyX')skillX();});
addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);
function damageArea(x,y,r,dmg,kind='normal'){ [...enemies,boss].filter(Boolean).forEach(t=>{if(Math.hypot(t.x-x,t.y-y)<r+t.size/2){t.hp-=dmg;if(kind==='ice')t.s*=.4;if(kind==='push'){t.x+=player.aim.x*45;t.y+=player.aim.y*45;} kill(t);}});effects.push({x,y,r,life:12,ice:kind==='ice'});}
function shot(speed,size,emoji,dmg,pierce=false,type='normal'){shots.push({x:player.x,y:player.y,dx:player.aim.x*speed,dy:player.aim.y*speed,size,emoji,dmg,life:80,pierce,type,hit:[]});}
function hit(){if(over||player.attackCd)return;player.attackCd=player.fruit?.buff==='speed'?10:20;const b=player.fruit?.buff||'none';if(['fire','ice','dragon'].includes(b))shot(b==='dragon'?15:12,b==='dragon'?48:25,b==='ice'?'❄️':b==='dragon'?'🔥':'☄️',player.damage*(b==='dragon'?4:1.5),b==='dragon',b);else damageArea(player.x,player.y,player.range,player.damage);}
function skillZ(){if(over||player.z)return;player.z=player.zMax;const b=player.fruit?.buff||'none';if(b==='fire')for(let i=-1;i<=1;i++)shots.push({x:player.x,y:player.y,dx:(player.aim.x+i*.3)*12,dy:(player.aim.y-i*.3)*12,size:25,emoji:'☄️',dmg:player.damage*1.5,life:60,pierce:false,type:'fire',hit:[]});else if(b==='ice')shot(18,30,'🧊',player.damage*2,true,'ice');else if(b==='dragon')damageArea(player.x,player.y,180,player.damage*4);else if(b==='speed'){player.x+=player.aim.x*180;player.y+=player.aim.y*180;damageArea(player.x,player.y,80,player.damage);}else damageArea(player.x,player.y,b==='giant'?200:90,player.damage*(b==='quake'?3:1.5),b==='giant'?'push':'normal');}
function skillX(){if(over||player.x)return;player.x=player.xMax;const b=player.fruit?.buff||'none';if(b==='giant')player.hp=Math.min(player.maxHp,player.hp+player.maxHp*.3);else if(b==='range')player.speed*=2;else if(b==='fire')shot(0,70,'🔥',player.damage*.5,true,'fire');else if(b==='ice')damageArea(player.x,player.y,250,player.damage*2,'ice');else if(b==='dragon')shot(5,110,'☄️',player.damage*8,true,'dragon');else damageArea(player.x,player.y,b==='quake'?800:150,player.damage*3);}
function kill(t){if(t.hp>0||t.dead)return;t.dead=true;if(t===boss){boss=null;wave++;kills=0;player.xp+=500*wave;player.beli+=5000*wave;}else{enemies=enemies.filter(e=>e!==t);kills++;player.xp+=30+wave*10;player.beli+=100*wave;if(kills>=5&&!boss)boss={x:400,y:80,size:90,s:2+wave*.1,hp:500+wave*600,maxHp:500+wave*600,damage:15+wave*5,img:bosses[(wave-1)%bosses.length]};}while(player.xp>=player.maxXp){player.xp-=player.maxXp;player.maxXp=Math.floor(player.maxXp*1.5);player.level++;player.maxHp+=20;player.hp=player.maxHp;player.damage+=5;}}
function collect(){if(Math.hypot(fruit.x-player.x,fruit.y-player.y)<player.size/2+fruit.size/2){player.fruit=fruit.data;player.beli+=fruit.data.stars*1000;player.xp+=100;player.size=40;player.speed=5;player.range=60;player.damage=35;player.img=fruit.data.player;const b=fruit.data.buff;if(b==='dmg')player.damage+=20;if(b==='range')player.range+=50;if(b==='speed')player.speed+=4;if(b==='giant'){player.size=80;player.range+=70;player.damage*=2;}if(b==='dragon'){player.size=85;player.damage*=3;player.speed+=2;}spawnFruit();}}
function update(){if(over)return;let x=(keys.a||keys.arrowleft?-1:0)+(keys.d||keys.arrowright?1:0),y=(keys.w||keys.arrowup?-1:0)+(keys.s||keys.arrowdown?1:0);if(x||y){const l=Math.hypot(x,y);player.x+=x/l*player.speed;player.y+=y/l*player.speed;}player.x=Math.max(player.size/2,Math.min(800-player.size/2,player.x));player.y=Math.max(player.size/2,Math.min(600-player.size/2,player.y));collect();
  for(let i=shots.length-1;i>=0;i--){const p=shots[i];p.x+=p.dx;p.y+=p.dy;p.life--;let hit=false;[...enemies,boss].filter(Boolean).forEach(t=>{if(p.hit.includes(t)||t.dead)return;if(Math.hypot(t.x-p.x,t.y-p.y)<t.size/2+p.size/2){t.hp-=p.dmg;p.hit.push(t);hit=true;if(p.type==='ice')t.s=Math.max(.5,t.s*.4);kill(t);}});if((hit&&!p.pierce)||p.life<0||p.x<-100||p.x>900||p.y<-100||p.y>700)shots.splice(i,1);}
  [...enemies,boss].filter(Boolean).forEach(t=>{if(t.dead)return;t.s=Math.min(t.s+(t.base?.1:.01),t.base||4);const a=Math.atan2(player.y-t.y,player.x-t.x);t.x+=Math.cos(a)*t.s;t.y+=Math.sin(a)*t.s;if(Math.hypot(player.x-t.x,player.y-t.y)<player.size/2+t.size/2-8)player.hp-=t.damage/60;});
  if(enemies.length<6&&!boss&&Math.random()<.035)enemies.push({x:Math.random()<.5?0:800,y:Math.random()*600,size:35,img:'🦹',s:1.5+wave*.2,base:1.5+wave*.2,hp:50+wave*30,maxHp:50+wave*30,damage:8+wave});if(player.attackCd)player.attackCd--;if(player.z)player.z--;if(player.x)player.x--;if(player.hp<=0)over=true;document.getElementById('cdZ').style.height=(player.z/player.zMax*100)+'%';document.getElementById('cdX').style.height=(player.x/player.xMax*100)+'%';}
function bar(x,y,w,h,v,max,color){ctx.fillStyle='#5b1b1b';ctx.fillRect(x-w/2,y,w,h);ctx.fillStyle=color;ctx.fillRect(x-w/2,y,w*Math.max(0,v/max),h);}
function draw(){ctx.clearRect(0,0,800,600);if(over){ctx.fillStyle='#e74c3c';ctx.font='bold 54px Arial';ctx.fillText('YOU DIED',400,300);return;}ctx.font=fruit.size+'px Arial';ctx.fillText(fruit.data.emoji,fruit.x,fruit.y);ctx.font='12px Arial';ctx.fillStyle='#ffe66d';ctx.fillText('★'.repeat(fruit.data.stars),fruit.x,fruit.y-22);effects.forEach((e,i)=>{ctx.fillStyle=e.ice?'rgba(0,255,255,.35)':'rgba(255,255,255,.35)';ctx.beginPath();ctx.arc(e.x,e.y,e.r,0,7);ctx.fill();if(!--e.life)effects.splice(i,1);});enemies.forEach(t=>{ctx.font=t.size+'px Arial';ctx.fillText(t.img,t.x,t.y);bar(t.x,t.y-t.size/2-9,32,5,t.hp,t.maxHp,'#2ecc71');});shots.forEach(p=>{ctx.font=p.size+'px Arial';ctx.fillText(p.emoji,p.x,p.y);});if(boss){ctx.font=boss.size+'px Arial';ctx.fillText(boss.img,boss.x,boss.y);bar(400,28,400,14,boss.hp,boss.maxHp,'#8e44ad');ctx.fillStyle='#fff';ctx.font='bold 14px Arial';ctx.fillText('BOSS WAVE '+wave,400,35);}ctx.strokeStyle='rgba(255,255,255,.25)';ctx.beginPath();ctx.moveTo(player.x,player.y);ctx.lineTo(player.x+player.aim.x*100,player.y+player.aim.y*100);ctx.stroke();ctx.font=player.size+'px Arial';ctx.fillText(player.img||'👦',player.x,player.y);ctx.textAlign='left';ctx.fillStyle='#fff';ctx.font='bold 16px Arial';ctx.fillText(`🌊 Wave: ${wave} | Lv: ${player.level} | 💰 ${player.beli}`,10,18);ctx.fillText('Fruit: '+(player.fruit?.name||'None'),10,38);bar(85,52,150,10,player.hp,player.maxHp,'#2ecc71');bar(85,68,150,8,player.xp,player.maxXp,'#f1c40f');ctx.textAlign='center';}
function loop(){update();draw();requestAnimationFrame(loop);}spawnFruit();
document.querySelectorAll('.move').forEach(b=>{const k=b.dataset.key;const on=e=>{e.preventDefault();keys[k]=true;};const off=e=>{e.preventDefault();keys[k]=false;};b.addEventListener('pointerdown',on);b.addEventListener('pointerup',off);b.addEventListener('pointercancel',off);b.addEventListener('pointerleave',off);});
document.getElementById('btnAttack').addEventListener('pointerdown',e=>{e.preventDefault();hit();});document.getElementById('btnZ').addEventListener('pointerdown',e=>{e.preventDefault();skillZ();});document.getElementById('btnX').addEventListener('pointerdown',e=>{e.preventDefault();skillX();});loop();
</script>
</body>
</html>
