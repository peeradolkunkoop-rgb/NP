    </main>

    <!-- Custom Toast Notification -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="bg-slate-900 dark:bg-slate-800 text-white px-5 py-3 rounded-2xl shadow-2xl border border-slate-700 flex items-center space-x-3 text-sm">
            <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400"></i>
            <span id="toast-message">Action successful!</span>
        </div>
    </div>

    <script>
        // Global App State & Firebase references
        let db, auth, appId, userId;
        let allSnippets = [];
        let currentSnippet = null;

        const router = {
            navigate: function(viewName, param = null) {
                document.getElementById('view-explore').classList.add('hidden');
                document.getElementById('view-create').classList.add('hidden');
                document.getElementById('view-detail').classList.add('hidden');

                document.getElementById('nav-explore').classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-brand-600', 'dark:text-brand-400');
                
                if (viewName === 'explore') {
                    document.getElementById('view-explore').classList.remove('hidden');
                    document.getElementById('nav-explore').classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-brand-600', 'dark:text-brand-400');
                    window.location.hash = '';
                } else if (viewName === 'create') {
                    document.getElementById('view-create').classList.remove('hidden');
                    document.getElementById('snippet-form').reset();
                    window.location.hash = 'create';
                } else if (viewName === 'detail' && param) {
                    document.getElementById('view-detail').classList.remove('hidden');
                    appState.fetchSnippetById(param);
                }
                lucide.createIcons();
            }
        };

        const appState = {
            init: async function() {
                try {
                    const firebaseConfig = JSON.parse(typeof __firebase_config !== 'undefined' ? __firebase_config : '{}');
                    appId = typeof __app_id !== 'undefined' ? __app_id : 'codehub-default-app';
                    
                    const app = window.firebaseModules.initializeApp(firebaseConfig);
                    db = window.firebaseModules.getFirestore(app);
                    auth = window.firebaseModules.getAuth(app);

                    const initialToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
                    if (initialToken) {
                        await window.firebaseModules.signInWithCustomToken(auth, initialToken);
                    } else {
                        await window.firebaseModules.signInAnonymously(auth);
                    }

                    userId = auth.currentUser?.uid || crypto.randomUUID();
                    document.getElementById('auth-user-id').textContent = `User: ${userId.substring(0, 8)}...`;

                    // Check URL hash for direct routing
                    const hash = window.location.hash;
                    if (hash.startsWith('#snippet=')) {
                        const snippetId = hash.replace('#snippet=', '');
                        router.navigate('detail', snippetId);
                    } else if (hash === '#create') {
                        router.navigate('create');
                    } else {
                        router.navigate('explore');
                    }

                    this.loadSnippets();
                } catch (err) {
                    console.error('Initialization error:', err);
                    showToast('Failed to initialize cloud connection', 'error');
                }
            },

            loadSnippets: async function() {
                if (!db) return;
                const refreshIcon = document.getElementById('refresh-icon');
                if (refreshIcon) refreshIcon.classList.add('animate-spin');

                try {
                    const colRef = window.firebaseModules.collection(db, 'artifacts', appId, 'public', 'data', 'snippets');
                    const snapshot = await window.firebaseModules.getDocs(colRef);
                    
                    allSnippets = [];
                    snapshot.forEach(docSnap => {
                        allSnippets.push({ id: docSnap.id, ...docSnap.data() });
                    });

                    // Sort in memory by createdAt descending (Rule 2 compliant)
                    allSnippets.sort((a, b) => new Date(b.createdAt || 0) - new Date(a.createdAt || 0));

                    this.renderSnippets(allSnippets);
                } catch (err) {
                    console.error('Error loading snippets:', err);
                    document.getElementById('snippets-grid').innerHTML = `
                        <div class="col-span-full py-12 text-center text-red-500">
                            <p>Failed to load snippets. Please try refreshing.</p>
                        </div>
                    `;
                } finally {
                    if (refreshIcon) refreshIcon.classList.remove('animate-spin');
                }
            },

            renderSnippets: function(snippets) {
                const grid = document.getElementById('snippets-grid');
                if (snippets.length === 0) {
                    grid.innerHTML = `
                        <div class="col-span-full py-16 text-center text-slate-400 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
                            <i data-lucide="file-code" class="w-10 h-10 mx-auto mb-3 opacity-40"></i>
                            <p class="text-base font-medium">No code snippets found</p>
                            <p class="text-xs text-slate-500 mt-1">Be the first to publish a code snippet to the cloud repository!</p>
                            <button onclick="router.navigate('create')" class="mt-4 px-4 py-2 bg-brand-600 text-white rounded-xl text-sm font-medium shadow-md shadow-brand-600/20">Create Snippet</button>
                        </div>
                    `;
                    lucide.createIcons();
                    return;
                }

                grid.innerHTML = snippets.map(s => `
                    <div onclick="appState.openSnippet('${s.id}')" class="group bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md hover:border-brand-500 dark:hover:border-brand-500 transition-all cursor-pointer flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-brand-50 dark:bg-brand-950 text-brand-600 dark:text-brand-400 border border-brand-200 dark:border-brand-800 uppercase">${s.language || 'text'}</span>
                                <span class="text-xs text-slate-400">${new Date(s.createdAt).toLocaleDateString()}</span>
                            </div>
                            <h3 class="font-bold text-lg group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-1">${s.title}</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400 font-mono mt-2 bg-slate-50 dark:bg-slate-950 p-3 rounded-xl line-clamp-3 border border-slate-100 dark:border-slate-800/80">${escapeHtml(s.code)}</p>
                        </div>
                        <div class="flex items-center justify-between pt-4 mt-4 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-400">
                            <span class="flex items-center space-x-1">
                                <i data-lucide="user" class="w-3.5 h-3.5"></i>
                                <span>${s.author ? s.author.substring(0, 6) + '...' : 'Anonymous'}</span>
                            </span>
                            <span class="font-medium text-brand-600 dark:text-brand-400 group-hover:underline flex items-center space-x-1">
                                <span>View Code</span>
                                <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                            </span>
                        </div>
                    </div>
                `).join('');
                lucide.createIcons();
            },

            filterSnippets: function() {
                const query = document.getElementById('search-input').value.toLowerCase();
                const filtered = allSnippets.filter(s => 
                    s.title.toLowerCase().includes(query) || 
                    s.language.toLowerCase().includes(query) || 
                    s.code.toLowerCase().includes(query)
                );
                this.renderSnippets(filtered);
            },

            saveSnippet: async function(e) {
                e.preventDefault();
                const title = document.getElementById('snippet-title').value;
                const language = document.getElementById('snippet-lang').value;
                const code = document.getElementById('snippet-code').value;
                const saveBtn = document.getElementById('save-btn');

                saveBtn.disabled = true;
                saveBtn.innerHTML = `<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i><span>Publishing...</span>`;
                lucide.createIcons();

                try {
                    const snippetId = 'snip_' + Math.random().toString(36).substring(2, 10);
                    const docRef = window.firebaseModules.doc(db, 'artifacts', appId, 'public', 'data', 'snippets', snippetId);
                    
                    const payload = {
                        id: snippetId,
                        title,
                        language,
                        code,
                        author: userId,
                        createdAt: new Date().toISOString()
                    };

                    await window.firebaseModules.setDoc(docRef, payload);
                    showToast('Snippet successfully published to the cloud!');
                    router.navigate('detail', snippetId);
                    this.loadSnippets();
                } catch (err) {
                    console.error('Error saving snippet:', err);
                    showToast('Error publishing snippet. Try again.', 'error');
                } finally {
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = `<i data-lucide="cloud-upload" class="w-4 h-4"></i><span>Publish to Cloud</span>`;
                    lucide.createIcons();
                }
            },

            openSnippet: function(id) {
                window.location.hash = `snippet=${id}`;
                router.navigate('detail', id);
            },

            fetchSnippetById: async function(id) {
                try {
                    const docRef = window.firebaseModules.doc(db, 'artifacts', appId, 'public', 'data', 'snippets', id);
                    const docSnap = await window.firebaseModules.getDoc(docRef);

                    if (docSnap.exists()) {
                        currentSnippet = docSnap.data();
                        document.getElementById('detail-title').textContent = currentSnippet.title;
                        document.getElementById('detail-lang-badge').textContent = currentSnippet.language;
                        document.getElementById('detail-date').textContent = new Date(currentSnippet.createdAt).toLocaleString();
                        document.getElementById('detail-id').textContent = currentSnippet.id;
                        
                        const codeBlock = document.getElementById('detail-code-block');
                        codeBlock.className = `language-${currentSnippet.language} text-sm leading-relaxed`;
                        codeBlock.textContent = currentSnippet.code;
                        hljs.highlightElement(codeBlock);
                    } else {
                        showToast('Snippet not found or has been deleted.', 'error');
                        router.navigate('explore');
                    }
                } catch (err) {
                    console.error('Error fetching snippet:', err);
                    showToast('Failed to retrieve snippet.', 'error');
                    router.navigate('explore');
                }
            },

            copyCurrentCode: function() {
                if (!currentSnippet) return;
                const textArea = document.createElement('textarea');
                textArea.value = currentSnippet.code;
                document.body.appendChild(textArea);
                textArea.select();
                try {
                    document.execCommand('copy');
                    showToast('Code copied to clipboard!');
                } catch (err) {
                    showToast('Failed to copy code', 'error');
                }
                document.body.removeChild(textArea);
            },

            downloadCurrentCode: function() {
                if (!currentSnippet) return;
                const extensions = { javascript: 'js', python: 'py', html: 'html', css: 'css', cpp: 'cpp', java: 'java', sql: 'sql', json: 'json', markdown: 'md' };
                const ext = extensions[currentSnippet.language] || 'txt';
                const filename = `${currentSnippet.title.toLowerCase().replace(/[^a-z0-9]/g, '_')}.${ext}`;
                
                const blob = new Blob([currentSnippet.code], { type: 'text/plain;charset=utf-8' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                showToast(`Downloaded ${filename}`);
            }
        };

        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, m => map[m]);
        }

        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
