                        </button>
                        <button type="submit" id="save-btn" class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-medium text-sm shadow-lg shadow-brand-600/30 flex items-center space-x-2 transition-transform active:scale-95">
