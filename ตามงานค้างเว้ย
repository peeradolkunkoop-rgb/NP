<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>ระบบจัดการงานค้าง มือถือ</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; -webkit-tap-highlight-color: transparent; }
    body { background: #0f172a; color: #f8fafc; padding: 14px; min-height: 100vh; display: flex; justify-content: center; }
    .container { width: 100%; max-width: 480px; }
    h1 { font-size: 18px; text-align: center; margin-bottom: 14px; color: #38bdf8; }
    .form-box { background: #1e293b; padding: 14px; border-radius: 12px; display: flex; flex-direction: column; gap: 10px; margin-bottom: 14px; border: 1px solid #334155; }
    input, button { width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #475569; background: #0f172a; color: #fff; font-size: 14px; outline: none; }
    input[type="date"] { min-height: 45px; }
    .btn-save { background: #0284c7; border: none; font-weight: bold; cursor: pointer; color: #fff; }
    .btn-cancel { background: #64748b; border: none; cursor: pointer; display: none; color: #fff; }
    .msg-box { font-size: 12px; color: #f87171; text-align: center; display: none; }
    .filter-box { background: #1e293b; padding: 12px; border-radius: 10px; margin-bottom: 14px; border: 1px solid #334155; }
    .filter-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .summary-text { font-size: 13px; color: #38bdf8; font-weight: bold; }
    .task-item { background: #1e293b; border: 1px solid #334155; padding: 12px; border-radius: 10px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .task-item.done { opacity: 0.5; }
    .task-item.done .t-title { text-decoration: line-through; }
    .t-title { font-size: 14px; font-weight: 600; word-break: break-all; }
    .t-meta { font-size: 12px; color: #94a3b8; margin-top: 4px; }
    .actions { display: flex; gap: 6px; flex-shrink: 0; margin-left: 8px; }
    .btn-sm { padding: 8px 10px; font-size: 12px; border-radius: 6px; border: none; cursor: pointer; }
    .btn-edit { background: #eab308; color: #000; font-weight: bold; }
    .btn-done { background: #22c55e; color: #000; font-weight: bold; }
    .btn-del { background: #ef4444; color: #fff; }
  </style>
</head>
<body>
  <div class="container">
    <h1>📋 จัดการงานค้าง (เวอร์ชันมือถือ)</h1>
    <div class="form-box">
      <input type="text" id="taskTitle" placeholder="พิมพ์ชื่องาน/การบ้านที่ค้าง...">
      <input type="date" id="taskDeadline">
      <div class="msg-box" id="msgBox"></div>
      <button type="button" class="btn-save" id="saveBtn" onclick="handleSave()">+ บันทึกงานค้าง</button>
      <button type="button" class="btn-cancel" id="cancelBtn" onclick="cancelEdit()">ยกเลิกการแก้ไข</button>
    </div>
    <div class="filter-box">
      <div class="filter-row">
        <span style="font-size:12px;">🔍 ดูงานตามวัน:</span>
        <input type="date" id="filterDate" onchange="renderTasks()" style="width: auto; padding: 6px;">
      </div>
      <div class="summary-text" id="summaryText">งานค้างทั้งหมด: 0 งาน</div>
    </div>
    <div id="taskList"></div>
  </div>

  <script>
    let memoryTasks = [];
    let editId = null;

    function loadTasks() {
      try {
        const data = localStorage.getItem('mobile_tasks_app');
        if (data) memoryTasks = JSON.parse(data);
      } catch (e) {
        console.warn('Storage blocked, using memory mode');
      }
    }

    function saveStorage() {
      try {
        localStorage.setItem('mobile_tasks_app', JSON.stringify(memoryTasks));
      } catch (e) {}
    }

    function showMsg(text) {
      const el = document.getElementById('msgBox');
      el.textContent = text;
      el.style.display = 'block';
      setTimeout(() => { el.style.display = 'none'; }, 2500);
    }

    function handleSave() {
      const title = document.getElementById('taskTitle').value.trim();
      const deadline = document.getElementById('taskDeadline').value;
      if (!title || !deadline) {
        showMsg('กรุณากรอกชื่องานและเลือกวันกำหนดส่งให้ครบ');
        return;
      }
      if (editId !== null) {
        memoryTasks = memoryTasks.map(t => t.id === editId ? { ...t, title, deadline } : t);
        editId = null;
        document.getElementById('saveBtn').textContent = '+ บันทึกงานค้าง';
        document.getElementById('cancelBtn').style.display = 'none';
      } else {
        memoryTasks.unshift({ id: Date.now(), title, deadline, completed: false });
      }
      document.getElementById('taskTitle').value = '';
      document.getElementById('taskDeadline').value = '';
      saveStorage();
      renderTasks();
    }

    function editTask(id) {
      const t = memoryTasks.find(x => x.id === id);
      if (!t) return;
      editId = id;
      document.getElementById('taskTitle').value = t.title;
      document.getElementById('taskDeadline').value = t.deadline;
      document.getElementById('saveBtn').textContent = '💾 บันทึกการแก้ไข';
      document.getElementById('cancelBtn').style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function cancelEdit() {
      editId = null;
      document.getElementById('taskTitle').value = '';
      document.getElementById('taskDeadline').value = '';
      document.getElementById('saveBtn').textContent = '+ บันทึกงานค้าง';
      document.getElementById('cancelBtn').style.display = 'none';
    }

    function toggleTask(id) {
      memoryTasks = memoryTasks.map(t => t.id === id ? { ...t, completed: !t.completed } : t);
      saveStorage();
      renderTasks();
    }

    function deleteTask(id) {
      memoryTasks = memoryTasks.filter(t => t.id !== id);
      saveStorage();
      renderTasks();
    }

    function renderTasks() {
      const list = document.getElementById('taskList');
      const filter = document.getElementById('filterDate').value;
      list.innerHTML = '';
      let items = memoryTasks;
      if (filter) {
        items = memoryTasks.filter(t => t.deadline === filter);
      }
      const pending = items.filter(t => !t.completed).length;
      document.getElementById('summaryText').textContent = filter 
        ? `งานค้างวันที่ ${filter}: ${pending} งาน` 
        : `งานค้างทั้งหมด: ${pending} งาน`;

      items.forEach(t => {
        const div = document.createElement('div');
        div.className = `task-item ${t.completed ? 'done' : ''}`;
        div.innerHTML = `
          <div>
            <div class="t-title">${t.title}</div>
            <div class="t-meta">📅 กำหนด: ${t.deadline}</div>
          </div>
          <div class="actions">
            <button type="button" class="btn-sm btn-edit" onclick="editTask(${t.id})">แก้</button>
            <button type="button" class="btn-sm btn-done" onclick="toggleTask(${t.id})">${t.completed ? 'ทำต่อ' : 'เสร็จ'}</button>
            <button type="button" class="btn-sm btn-del" onclick="deleteTask(${t.id})">ลบ</button>
          </div>
        `;
        list.appendChild(div);
      });
    }

    loadTasks();
    renderTasks();
  </script>
</body>
</html>
